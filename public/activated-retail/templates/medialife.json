  "tour": [
    {
      "title": "One fixture. Any floor.",
      "body": "A 3.84 m activated-retail fixture: two lightbox towers, a lit header, a 12-tile video wall and a hero screen. It stands in a store aisle, a pop-up shop or a convention booth.",
      "view": "aisle",
      "theme": "medialife"
    },
    {
      "title": "Your IP on every surface",
      "body": "Towers, header, video wall and totem carry your key art. Switch the property at the top: the same hardware re-skins in seconds for each drop.",
      "view": "hero",
      "theme": "sukeban"
    },
    {
      "title": "Every product opens an experience",
      "body": "Apparel, stickers, keychains and collectibles, each with an NFC tag or QR code built in. Tap any glowing marker to pick one up.",
      "view": "shelf"
    },
    {
      "title": "Tap, play, unlock",
      "body": "The QR on the right tower is live: scan it and this program opens on your phone. On the shelf, one tap starts a game, an AR moment or a reward.",
      "view": "qr"
    },
    {
      "title": "See it in your space",
      "body": "Place the full-size fixture in your own room and walk around it. It opens in AR Quick Look on iPhone and Google Scene Viewer on Android, with no app to install. On a computer you get a QR code for your phone.",
      "view": "aisle",
      "ar": true
    },
    {
      "title": "Measured, live",
      "body": "Scans, plays, returns and sales by product and hour, from the first day on the floor.",
      "view": "dashboard",
      "theme": "trainwreck",
      "dashboard": true
    },
    {
      "title": "Built modular",
      "body": "Six modules bolt together on site, so each drop swaps graphics and merch, not fixtures.",
      "view": "build"
    }
  ],
